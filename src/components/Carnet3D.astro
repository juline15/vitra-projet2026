---
// Carnet en 3D (three.js). Glisser pour le faire pivoter.
interface Props {
    class?: string;
}
const { class: cls = "" } = Astro.props;
---

<div
    class:list={[
        "carnet-3d relative aspect-[4/5] overflow-hidden bg-plaster",
        cls,
    ]}
>
    <canvas
        class="block h-full w-full cursor-grab touch-pan-y active:cursor-grabbing"
        role="img"
        aria-label="Modèle 3D du carnet dessiné par Maxime Bellaunay"></canvas>
    <p class="pointer-events-none absolute bottom-3 left-3 text-xs text-stone">
        Faites glisser pour tourner
    </p>
</div>

<script>
    import * as THREE from "three";
    import { OrbitControls } from "three/addons/controls/OrbitControls.js";
    import { buildCarnet } from "../lib/objets3d";

    function init(container: HTMLElement) {
        const canvas = container.querySelector("canvas")!;
        const reduceMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        const renderer = new THREE.WebGLRenderer({
            canvas,
            antialias: true,
            alpha: true,
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        renderer.outputColorSpace = THREE.SRGBColorSpace;

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 50);
        camera.position.set(0, 0.4, 7.5);

        // Lumière rasante qui fait ressortir le relief
        scene.add(new THREE.HemisphereLight(0xffffff, 0xd8cfc2, 1.4));
        const sun = new THREE.DirectionalLight(0xfff4e6, 2.6);
        sun.position.set(-4, 5, 5);
        sun.castShadow = true;
        sun.shadow.mapSize.set(1024, 1024);
        sun.shadow.radius = 6;
        sun.shadow.camera.left = -5;
        sun.shadow.camera.right = 5;
        sun.shadow.camera.top = 5;
        sun.shadow.camera.bottom = -5;
        scene.add(sun);

        // Sol invisible qui ne garde que l'ombre portée
        const ground = new THREE.Mesh(
            new THREE.PlaneGeometry(12, 12),
            new THREE.ShadowMaterial({ opacity: 0.12 }),
        );
        ground.rotation.x = -Math.PI / 2;
        ground.position.y = -1.12;
        ground.receiveShadow = true;
        scene.add(ground);

        const carnet = buildCarnet();
        scene.add(carnet);

        const controls = new OrbitControls(camera, canvas);
        controls.enableZoom = false;
        controls.enablePan = false;
        controls.enableDamping = true;
        controls.minPolarAngle = Math.PI / 2.6;
        controls.maxPolarAngle = Math.PI / 1.9;
        controls.autoRotate = !reduceMotion;
        controls.autoRotateSpeed = 1.2;

        // Taille du rendu = taille du cadre
        const resize = () => {
            const { clientWidth: w, clientHeight: h } = container;
            renderer.setSize(w, h, false);
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
        };
        new ResizeObserver(resize).observe(container);
        resize();

        // N'anime que lorsque le carnet est visible à l'écran
        let visible = false;
        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
        }).observe(container);

        renderer.setAnimationLoop(() => {
            if (!visible) return;
            controls.update();
            renderer.render(scene, camera);
        });
    }

    // Attend la police pour que le logo « vitra. » soit dessiné en Futura
    document.fonts.ready.then(() => {
        document.querySelectorAll<HTMLElement>(".carnet-3d").forEach(init);
    });
</script>
