---
import Media from "./Media.astro";
import { event } from "../data/event";
---

<section aria-labelledby="titre">
    <div class="mx-auto max-w-screen-2xl px-5 pt-8 md:px-10 md:pt-16">
        <h1
            id="titre"
            class="text-center font-display text-2xl font-bold tracking-tight sm:text-3xl md:text-5xl"
        >
            {event.heading}
        </h1>

        <div class="mx-auto mt-6 flex max-w-4xl justify-center md:mt-10">
            {
                event.logo ? (
                    <img
                        src={event.logo}
                        alt={event.title}
                        class="h-auto w-full max-w-150"
                    />
                ) : (
                    <span class="flex aspect-[4/1] w-full items-center justify-center border border-dashed border-stone/60 bg-plaster text-sm text-stone">
                        Logo « {event.title} », format rectangulaire
                    </span>
                )
            }
        </div>

        <div
            class="mt-8 grid gap-6 border-t border-ink pt-5 md:mt-10 md:gap-8 md:pt-6 lg:grid-cols-12"
        >
            <p
                class="font-display text-xl leading-tight md:text-3xl lg:col-span-7 lg:text-4xl"
            >
                {event.subtitle}
            </p>
            <dl
                class="grid grid-cols-2 gap-6 text-sm lg:col-span-4 lg:col-start-9"
            >
                <div>
                    <dt class="text-stone">Date</dt>
                    <dd class="mt-1 text-base">{event.date}</dd>
                </div>
                <div>
                    <dt class="text-stone">Lieu</dt>
                    <dd class="mt-1 text-base">
                        {event.location.name}<br />{event.location.city}
                    </dd>
                </div>
            </dl>
        </div>
    </div>

    <Media
        class="mt-10 md:mt-16"
        type="video"
        autoplay
        src={event.teaser.src}
        poster={event.teaser.poster}
        alt="Teaser vidéo de l'événement"
        label="Teaser vidéo (16:9)"
        ratio="aspect-video"
    />
</section>
