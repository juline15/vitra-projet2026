---
import Media from "./Media.astro";
import { event } from "../data/event";
---

<section aria-labelledby="titre">
    <!-- Scène d'ouverture : la gourde et le carnet en 3D encadrent le titre -->
    <div class="relative isolate overflow-hidden">
        <canvas
            id="hero-stage"
            class="pointer-events-none absolute inset-0 -z-10 h-full w-full"
            aria-hidden="true"></canvas>

        <div
            class="mx-auto flex min-h-[calc(100svh-3.5rem)] max-w-screen-2xl flex-col items-center justify-center px-5 py-16 md:min-h-[calc(100svh-4.25rem)] md:px-10"
        >
            <h1
                id="titre"
                class="hero-reveal text-center font-display text-2xl font-bold tracking-tight sm:text-3xl md:text-5xl"
                style="animation-delay: 0.5s"
            >
                {event.heading}
            </h1>

            <div
                class="hero-reveal mx-auto mt-6 flex w-full max-w-4xl justify-center md:mt-10"
                style="animation-delay: 0.8s"
            >
                {
                    event.logo ? (
                        <img
                            src={event.logo}
                            alt={event.title}
                            class="h-auto w-full max-w-150"
                        />
                    ) : (
                        <span class="flex aspect-[4/1] w-full max-w-150 items-center justify-center border border-dashed border-stone/60 bg-plaster/80 text-sm text-stone">
                            Logo « {event.title} », format rectangulaire
                        </span>
                    )
                }
            </div>
        </div>
    </div>

    <div class="mx-auto max-w-screen-2xl px-5 md:px-10">
        <div
            class="hero-reveal grid gap-6 border-t border-ink pt-5 md:gap-8 md:pt-6 lg:grid-cols-12"
            style="animation-delay: 1.1s"
        >
            <p
                class="font-display text-xl leading-tight md:text-3xl lg:col-span-7 lg:text-4xl"
            >
                {event.subtitle}
            </p>
            <dl
                class="grid grid-cols-2 gap-6 text-sm lg:col-span-4 lg:col-start-9"
            >
                <div>
                    <dt class="text-stone">Date</dt>
                    <dd class="mt-1 text-base">{event.date}</dd>
                </div>
                <div>
                    <dt class="text-stone">Lieu</dt>
                    <dd class="mt-1 text-base">
                        {event.location.name}<br />{event.location.city}
                    </dd>
                </div>
            </dl>
        </div>
    </div>

    <Media
        class="mt-10 md:mt-16"
        type="video"
        autoplay
        src={event.teaser.src}
        poster={event.teaser.poster}
        alt="Teaser vidéo de l'événement"
        label="Teaser vidéo (16:9)"
        ratio="aspect-video"
    />
</section>

<script>
    import * as THREE from "three";
    import { buildGourde, buildCarnet } from "../lib/objets3d";

    const canvas = document.getElementById("hero-stage") as HTMLCanvasElement;
    const stage = canvas.parentElement as HTMLElement;
    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    // Courbes d'animation
    const easeOutBack = (t: number) =>
        1 + 2.2 * (t - 1) ** 3 + 1.2 * (t - 1) ** 2;
    const easeOutCubic = (t: number) => 1 - (1 - t) ** 3;
    const clamp01 = (t: number) => Math.min(Math.max(t, 0), 1);

    function start() {
        const renderer = new THREE.WebGLRenderer({
            canvas,
            antialias: true,
            alpha: true,
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        renderer.outputColorSpace = THREE.SRGBColorSpace;

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 60);
        camera.position.set(0, 0, 12);

        scene.add(new THREE.HemisphereLight(0xffffff, 0xd8cfc2, 1.5));
        const sun = new THREE.DirectionalLight(0xfff4e6, 2.4);
        sun.position.set(-5, 6, 8);
        scene.add(sun);

        // Chaque objet est placé dans un « pivot » qu'on déplace et fait tourner
        const gourde = new THREE.Group();
        gourde.add(buildGourde());
        const carnet = new THREE.Group();
        const carnetModel = buildCarnet();
        carnetModel.rotation.y = -0.35;
        carnet.add(carnetModel);
        scene.add(gourde, carnet);

        // Positions de repos selon le format de l'écran
        const rest = {
            gourde: new THREE.Vector3(),
            carnet: new THREE.Vector3(),
            scale: 1,
        };
        const layout = () => {
            const { clientWidth: w, clientHeight: h } = stage;
            renderer.setSize(w, h, false);
            camera.aspect = w / h;
            camera.updateProjectionMatrix();

            const halfH =
                Math.tan(THREE.MathUtils.degToRad(camera.fov / 2)) *
                camera.position.z;
            const halfW = halfH * camera.aspect;

            if (camera.aspect > 1.1) {
                // Écran large : un objet de chaque côté du logo
                rest.scale = Math.min(0.72, halfH / 4.5);
                rest.gourde.set(-halfW * 0.74, -0.55, 0);
                rest.carnet.set(halfW * 0.74, -0.35, 0);
            } else {
                // Écran vertical : gourde en haut à gauche, carnet en bas à droite
                rest.scale = Math.min(0.75, halfW / 2.6);
                rest.gourde.set(-halfW * 0.58, halfH * 0.6, -1);
                rest.carnet.set(halfW * 0.58, -halfH * 0.62, -1);
            }
            if (reduceMotion) render(10);
        };

        // Souris : léger effet de profondeur
        const pointer = new THREE.Vector2();
        const smooth = new THREE.Vector2();
        window.addEventListener("pointermove", (e) => {
            pointer.set(
                (e.clientX / window.innerWidth) * 2 - 1,
                (e.clientY / window.innerHeight) * 2 - 1,
            );
        });

        // Une image de l'animation, à l'instant t (en secondes)
        function render(t: number) {
            smooth.lerp(pointer, 0.05);

            // Entrée : les objets montent depuis le bas en tournant (gourde, puis carnet)
            const g = easeOutBack(clamp01(t / 1.4));
            const c = easeOutBack(clamp01((t - 0.25) / 1.4));
            const gSpin = 1 - easeOutCubic(clamp01(t / 1.6));
            const cSpin = 1 - easeOutCubic(clamp01((t - 0.25) / 1.6));

            // Ensuite : flottement lent, comme en apesanteur
            const idle = reduceMotion ? 0 : 1;
            const floatG = Math.sin(t * 0.9) * 0.12 * idle;
            const floatC = Math.sin(t * 0.8 + 1.5) * 0.12 * idle;

            gourde.position.set(
                rest.gourde.x,
                rest.gourde.y - 7 * (1 - g) + floatG,
                rest.gourde.z,
            );
            carnet.position.set(
                rest.carnet.x,
                rest.carnet.y - 7 * (1 - c) + floatC,
                rest.carnet.z,
            );
            gourde.scale.setScalar(rest.scale);
            carnet.scale.setScalar(rest.scale * 0.95);

            gourde.rotation.set(
                smooth.y * 0.15,
                0.5 -
                    gSpin * Math.PI * 2 +
                    Math.sin(t * 0.4) * 0.35 * idle +
                    smooth.x * 0.4,
                -0.08 + Math.sin(t * 0.7) * 0.04 * idle,
            );
            carnet.rotation.set(
                smooth.y * 0.15,
                -0.2 +
                    cSpin * Math.PI * 2 +
                    Math.sin(t * 0.35 + 1) * 0.3 * idle +
                    smooth.x * 0.4,
                0.12 + Math.sin(t * 0.6 + 2) * 0.04 * idle,
            );

            renderer.render(scene, camera);
        }

        new ResizeObserver(layout).observe(stage);
        layout();

        if (reduceMotion) return; // image fixe, sans animation

        // Animation uniquement quand le haut de page est visible
        let visible = true;
        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
        }).observe(stage);

        const clock = new THREE.Clock();
        renderer.setAnimationLoop(() => {
            const t = clock.getElapsedTime();
            if (visible) render(t);
        });
    }

    // Attend la police (logos dessinés en Futura) avant de construire la scène
    document.fonts.ready.then(start);
</script>
