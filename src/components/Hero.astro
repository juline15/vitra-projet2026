---
import Media from "./Media.astro";
import { event } from "../data/event";
---

<section aria-labelledby="titre">
    <div class="mx-auto max-w-screen-2xl px-5 pt-10 md:px-10 md:pt-16">
        <h1 id="titre" class="max-w-4xl">
            {
                event.logo ? (
                    <img
                        src={event.logo}
                        alt={event.title}
                        class="h-auto w-full"
                    />
                ) : (
                    <span class="flex aspect-[4/1] w-full items-center justify-center border border-dashed border-stone/60 bg-plaster text-sm font-normal text-stone">
                        <span class="sr-only">{event.title}</span>
                        <span aria-hidden="true">
                            Logo « {event.title} », format rectangulaire
                        </span>
                    </span>
                )
            }
        </h1>

        <div class="mt-10 grid gap-8 border-t border-ink pt-6 md:grid-cols-12">
            <p
                class="font-display text-2xl leading-tight md:col-span-7 md:text-4xl"
            >
                {event.subtitle}
            </p>
            <dl
                class="grid grid-cols-2 gap-6 text-sm md:col-span-4 md:col-start-9"
            >
                <div>
                    <dt class="text-stone">Date</dt>
                    <dd class="mt-1 text-base">{event.date}</dd>
                </div>
                <div>
                    <dt class="text-stone">Lieu</dt>
                    <dd class="mt-1 text-base">
                        {event.location.name}<br />{event.location.city}
                    </dd>
                </div>
            </dl>
        </div>
    </div>

    <Media
        class="mt-12 md:mt-16"
        type="video"
        autoplay
        src={event.teaser.src}
        poster={event.teaser.poster}
        alt="Teaser vidéo de l'événement"
        label="Teaser vidéo (16:9)"
        ratio="aspect-video md:aspect-[21/9]"
    />
</section>
