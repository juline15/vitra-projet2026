---
import Media from "./Media.astro";
import Gourde3D from "./Gourde3D.astro";
import Carnet3D from "./Carnet3D.astro";
import { visuels } from "../data/event";
---

<section
    id="visuels"
    class="mx-auto max-w-screen-2xl scroll-mt-24 px-5 py-16 md:px-10 md:py-24 lg:py-32"
>
    <h2
        class="font-display text-3xl font-semibold tracking-tight md:text-5xl lg:text-6xl"
    >
        Visuels
    </h2>

    <h3
        class="mt-10 border-t border-ink pt-3 font-display text-base font-semibold md:mt-16 md:pt-4 md:text-lg"
    >
        Affiches
    </h3>
    <ul
        class="mx-auto mt-6 grid max-w-2xl grid-cols-2 gap-x-4 gap-y-8 md:mt-8 md:gap-x-5 md:gap-y-10 lg:gap-x-8"
    >
        {
            visuels.affiches.map((a) => (
                <li>
                    <figure>
                        <Media
                            src={a.src}
                            alt={a.alt}
                            label={`Affiche (2:3) : ${a.caption}`}
                            ratio="aspect-[2/3]"
                        />
                        <figcaption class="mt-2 text-xs text-stone sm:text-sm md:mt-3">
                            {a.caption}
                        </figcaption>
                    </figure>
                </li>
            ))
        }
    </ul>
    
    <h3
        class="mt-16 border-t border-ink pt-3 font-display text-base font-semibold md:mt-24 md:pt-4 md:text-lg"
    >
        Les objets en 3D
    </h3>
    <ul class="mx-auto mt-6 grid max-w-3xl gap-8 sm:grid-cols-2 md:mt-8">
        <li>
            <Gourde3D />
            <p class="mt-2 text-sm text-stone md:mt-3">La gourde</p>
        </li>
        <li>
            <Carnet3D />
            <p class="mt-2 text-sm text-stone md:mt-3">Le carnet</p>
        </li>
    </ul>
</section>
