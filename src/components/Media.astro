---
interface Props {
    src?: string;
    alt: string;
    type?: "image" | "video";
    ratio?: string;
    label?: string;
    poster?: string;
    autoplay?: boolean;
    fit?: "cover" | "contain"; // ← ajouté
    class?: string;
}
const {
    src,
    alt,
    type = "image",
    ratio = "aspect-video",
    label,
    poster,
    autoplay = false,
    fit = "cover", // ← ajouté
    class: cls = "",
} = Astro.props;
---

<div class:list={["relative overflow-hidden bg-plaster", ratio, cls]}>
    {
        !src ? (
            <div class="absolute inset-0 flex items-center justify-center border border-dashed border-stone/50 p-2 text-center text-xs text-stone sm:p-4 sm:text-sm">
                {label ?? alt}
            </div>
        ) : type === "video" ? (
            autoplay ? (
                <video
                    src={src}
                    poster={poster || undefined}
                    class="h-full w-full object-cover"
                    aria-label={alt}
                    data-autoplay
                    muted
                    playsinline
                    preload="auto"
                />
            ) : (
                <video
                    src={src}
                    poster={poster || undefined}
                    class="h-full w-full object-cover"
                    aria-label={alt}
                    controls
                    playsinline
                    preload="metadata"
                />
            )
        ) : (
            <img
                src={src}
                alt={alt}
                loading="lazy"
                decoding="async"
                class={`h-full w-full ${fit === "contain" ? "object-contain" : "object-cover"}`}
            />
        )
    }
</div>

<script>
    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;
    const videos = document.querySelectorAll<HTMLVideoElement>(
        "video[data-autoplay]",
    );

    const showControls = (v: HTMLVideoElement) => {
        v.controls = true;
    };

    if (reduceMotion) {
        videos.forEach(showControls);
    } else {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach(({ target, isIntersecting }) => {
                    const v = target as HTMLVideoElement;
                    if (isIntersecting) {
                        v.play().catch(() => showControls(v));
                    } else {
                        v.pause();
                    }
                });
            },
            { threshold: 0.6 },
        );

        videos.forEach((v) => {
            observer.observe(v);
            v.addEventListener(
                "ended",
                () => {
                    observer.unobserve(v);
                    showControls(v);
                },
                { once: true },
            );
        });
    }
</script>
