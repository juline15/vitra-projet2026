---
import { batiment } from "../data/event";
---

<section id="batiment" class="scroll-mt-24 border-b border-concrete">
    <div class="mx-auto max-w-screen-2xl px-5 py-16 md:px-10 md:py-24 lg:py-32">
        <div class="grid gap-6 md:grid-cols-12 md:gap-10">
            <h2
                class="font-display text-3xl font-semibold tracking-tight md:col-span-5 md:text-5xl lg:text-6xl"
            >
                {batiment.title}
            </h2>
            <div
                class="max-w-prose space-y-4 md:col-span-7 md:space-y-5 lg:col-span-6 lg:col-start-7"
            >
                <p
                    class="font-display text-xl leading-snug md:text-2xl lg:text-3xl"
                >
                    {batiment.lead}
                </p>
                {
                    batiment.text.map((p) => (
                        <p class="text-base leading-relaxed md:text-lg">{p}</p>
                    ))
                }
            </div>
        </div>

        <ul class="mt-10 grid gap-8 md:mt-16 md:grid-cols-2 lg:gap-10">
            {
                [batiment.dessin, batiment.mockup].map((img) => (
                    <li>
                        <figure>
                            <div class="aspect-[4/3] bg-plaster">
                                <img
                                    src={img.src}
                                    alt={img.alt}
                                    loading="lazy"
                                    decoding="async"
                                    class="h-full w-full object-contain"
                                />
                            </div>
                            <figcaption class="mt-2 text-sm text-stone md:mt-3">
                                {img.caption}
                            </figcaption>
                        </figure>
                    </li>
                ))
            }
        </ul>
    </div>
</section>
