---
import Media from "./Media.astro";
import { concept } from "../data/event";
import Cta from "./Cta.astro";
---

<section
    id="concept"
    class="mx-auto max-w-screen-2xl scroll-mt-24 px-5 py-16 md:px-10 md:py-24 lg:py-32"
>
    <div class="grid gap-6 md:grid-cols-12 md:gap-10">
        <h2
            class="font-display text-3xl font-semibold tracking-tight md:col-span-5 md:text-5xl lg:text-6xl"
        >
            Le concept
        </h2>
        <div
            class="max-w-prose space-y-5 md:col-span-7 md:space-y-6 lg:col-span-6 lg:col-start-7"
        >
            <p
                class="font-display text-xl leading-snug md:text-2xl lg:text-3xl"
            >
                {concept.lead}
            </p>
            <p class="text-base leading-relaxed md:text-lg">{concept.intro}</p>
        </div>
    </div>

    <div class="mt-12 grid gap-px bg-concrete md:mt-20 md:grid-cols-2">
        {
            concept.temps.map((t) => (
                <article class="bg-paper py-6 md:py-10 md:odd:pr-10 md:even:pl-10">
                    <h3 class="font-display text-lg font-semibold md:text-xl">
                        {t.title}
                    </h3>
                    <p class="mt-3 max-w-prose leading-relaxed text-stone md:mt-4">
                        {t.text}
                    </p>
                </article>
            ))
        }
    </div>

    <div class="mt-16 grid gap-8 md:mt-24 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-4">
            <h3
                class="font-display text-2xl font-semibold tracking-tight md:text-3xl"
            >
                {concept.popup.title}
            </h3>
            <p
                class="mt-4 max-w-prose text-base leading-relaxed md:mt-6 md:text-lg"
            >
                {concept.popup.text}
            </p>
            <Cta href="#inscription" class="mt-6">S'inscrire à l'évènement</Cta>
        </div>

        <ul
            class="grid gap-6 sm:grid-cols-2 sm:gap-8 lg:col-span-7 lg:col-start-6"
        >
            {
                concept.popup.objets.map((o) => (
                    <li class="flex flex-col overflow-hidden rounded-xl border border-concrete bg-paper">
                        <div class="relative">
                            <Media
                                src={o.image}
                                alt={o.alt}
                                label={`Visuel : ${o.name.toLowerCase()}`}
                                ratio="aspect-[4/3]"
                            />
                            <p class="absolute top-3 left-3 rounded-full bg-paper px-3 py-1 text-xs font-semibold text-ink">
                                {o.badge}
                            </p>
                        </div>
                        <div class="flex flex-1 flex-col p-5">
                            <p class="text-xs tracking-wide text-stone uppercase">
                                {o.collection}
                            </p>
                            <h4 class="mt-1 font-display text-xl font-semibold">
                                {o.name}
                            </h4>
                            <p class="mt-2 text-sm leading-relaxed text-stone">
                                {o.text}
                            </p>
                            <div class="mt-auto pt-5">
                                <Cta
                                    class="w-full"
                                    aria-haspopup="dialog"
                                    data-open-dialog={`objet-${o.id}`}
                                >
                                    Découvrir le produit
                                    <span class="sr-only"> : {o.name}</span>
                                </Cta>
                            </div>
                        </div>
                    </li>
                ))
            }
        </ul>
    </div>

    {
        concept.popup.objets.map((o) => (
            <dialog
                id={`objet-${o.id}`}
                aria-labelledby={`objet-${o.id}-titre`}
                class="m-auto max-h-[calc(100dvh-2rem)] w-[min(56rem,calc(100%-2rem))] overflow-y-auto rounded-xl bg-paper p-0 text-ink backdrop:bg-black/60"
            >
                <div class="grid md:grid-cols-2">
                    <Media
                        src={o.image}
                        alt={o.alt}
                        label={`Visuel : ${o.name.toLowerCase()}`}
                        ratio="aspect-[4/3] md:aspect-[4/5]"
                    />

                    <div class="relative p-6 md:p-8">
                        <button
                            type="button"
                            data-close-dialog
                            class="absolute top-3 right-3 flex h-11 w-11 items-center justify-center rounded-full hover:bg-plaster"
                        >
                            <span aria-hidden="true">✕</span>
                            <span class="sr-only">
                                Fermer la fiche : {o.name}
                            </span>
                        </button>

                        <p class="text-xs tracking-wide text-stone uppercase">
                            {o.collection}
                        </p>
                        <h3
                            id={`objet-${o.id}-titre`}
                            class="mt-1 pr-12 font-display text-3xl font-semibold"
                        >
                            {o.name}
                        </h3>
                        {o.description.map((p) => (
                            <p class="mt-4 leading-relaxed">{p}</p>
                        ))}

                        <dl class="mt-6 divide-y divide-concrete border-y border-concrete text-sm">
                            {o.details.map(([label, value]) => (
                                <div class="flex justify-between gap-4 py-2.5">
                                    <dt class="text-stone">{label}</dt>
                                    <dd class="text-right">{value}</dd>
                                </div>
                            ))}
                        </dl>

                        <p class="mt-6 text-sm text-stone">
                            En vente au pop-up store dès l'avant-première.
                        </p>
                        <Cta
                            href="#inscription"
                            data-close-dialog
                            class="mt-4 w-full"
                        >
                            S'inscrire à l'évènement
                        </Cta>
                    </div>
                </div>
            </dialog>
        ))
    }

    <script>
        const reduceMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        // Ouverture : la fiche s'ouvre en fenêtre modale, et le focus revient au bouton à la fermeture
        document
            .querySelectorAll<HTMLButtonElement>("[data-open-dialog]")
            .forEach((btn) => {
                const dialog = document.getElementById(
                    btn.dataset.openDialog!,
                ) as HTMLDialogElement;
                btn.addEventListener("click", () => dialog.showModal());
                dialog.addEventListener("close", () => {
                    if (dialog.dataset.skipFocus)
                        delete dialog.dataset.skipFocus;
                    else btn.focus();
                });
                // Clic sur le fond assombri : ferme la fiche
                dialog.addEventListener("click", (e) => {
                    if (e.target === dialog) dialog.close();
                });
            });

        // Fermeture : bouton ✕, ou bouton « S'inscrire » qui mène ensuite au formulaire
        document
            .querySelectorAll<HTMLElement>("[data-close-dialog]")
            .forEach((el) => {
                el.addEventListener("click", (e) => {
                    const dialog = el.closest("dialog")!;
                    const hash = el.getAttribute("href");
                    if (hash?.startsWith("#")) {
                        e.preventDefault();
                        dialog.dataset.skipFocus = "1";
                        dialog.close();
                        const target =
                            document.querySelector<HTMLElement>(hash);
                        target?.scrollIntoView({
                            behavior: reduceMotion ? "auto" : "smooth",
                        });
                        target?.focus({ preventScroll: true });
                    } else {
                        dialog.close();
                    }
                });
            });
    </script>
</section>
