---
import Media from "./Media.astro";
import { concept } from "../data/event";
---

<section
    id="concept"
    class="mx-auto max-w-screen-2xl scroll-mt-24 px-5 py-24 md:px-10 md:py-32"
>
    <div class="grid gap-10 md:grid-cols-12">
        <h2
            class="font-display text-4xl font-semibold tracking-tight md:col-span-5 md:text-6xl"
        >
            Le concept
        </h2>
        <div class="max-w-prose space-y-6 md:col-span-6 md:col-start-7">
            <p class="font-display text-2xl leading-snug md:text-3xl">
                {concept.lead}
            </p>
            <p class="text-lg leading-relaxed">{concept.intro}</p>
        </div>
    </div>

    <div class="mt-20 grid gap-px bg-concrete md:grid-cols-2">
        {
            concept.temps.map((t) => (
                <article class="bg-paper py-8 md:py-10 md:odd:pr-10 md:even:pl-10">
                    <h3 class="font-display text-xl font-semibold">
                        {t.title}
                    </h3>
                    <p class="mt-4 max-w-prose leading-relaxed text-stone">
                        {t.text}
                    </p>
                </article>
            ))
        }
    </div>

    <div class="mt-24 grid gap-10 md:grid-cols-12">
        <div class="md:col-span-4">
            <h3 class="font-display text-3xl font-semibold tracking-tight">
                {concept.popup.title}
            </h3>
            <p class="mt-6 max-w-prose text-lg leading-relaxed">
                {concept.popup.text}
            </p>
        </div>
        <ul class="grid gap-8 sm:grid-cols-2 md:col-span-7 md:col-start-6">
            {
                concept.popup.objets.map((o) => (
                    <li>
                        <Media
                            src={o.image}
                            alt={o.name}
                            label={`Visuel : ${o.name.toLowerCase()}`}
                            ratio="aspect-[4/5]"
                        />
                        <h4 class="mt-4 font-display text-lg font-semibold">
                            {o.name}
                        </h4>
                        <p class="mt-1 leading-relaxed text-stone">{o.text}</p>
                    </li>
                ))
            }
        </ul>
    </div>
</section>
