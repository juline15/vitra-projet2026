---
import Media from "./Media.astro";
import { concept } from "../data/event";
---

<section
    id="concept"
    class="mx-auto max-w-screen-2xl scroll-mt-24 px-5 py-16 md:px-10 md:py-24 lg:py-32"
>
    <div class="grid gap-6 md:grid-cols-12 md:gap-10">
        <h2
            class="font-display text-3xl font-semibold tracking-tight md:col-span-5 md:text-5xl lg:text-6xl"
        >
            Le concept
        </h2>
        <div
            class="max-w-prose space-y-5 md:col-span-7 md:space-y-6 lg:col-span-6 lg:col-start-7"
        >
            <p
                class="font-display text-xl leading-snug md:text-2xl lg:text-3xl"
            >
                {concept.lead}
            </p>
            <p class="text-base leading-relaxed md:text-lg">{concept.intro}</p>
        </div>
    </div>

    <div class="mt-12 grid gap-px bg-concrete md:mt-20 md:grid-cols-2">
        {
            concept.temps.map((t) => (
                <article class="bg-paper py-6 md:py-10 md:odd:pr-10 md:even:pl-10">
                    <h3 class="font-display text-lg font-semibold md:text-xl">
                        {t.title}
                    </h3>
                    <p class="mt-3 max-w-prose leading-relaxed text-stone md:mt-4">
                        {t.text}
                    </p>
                </article>
            ))
        }
    </div>

    <div class="mt-16 grid gap-8 md:mt-24 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-4">
            <h3
                class="font-display text-2xl font-semibold tracking-tight md:text-3xl"
            >
                {concept.popup.title}
            </h3>
            <p
                class="mt-4 max-w-prose text-base leading-relaxed md:mt-6 md:text-lg"
            >
                {concept.popup.text}
            </p>
        </div>
        <ul
            class="grid grid-cols-2 gap-4 sm:gap-8 lg:col-span-7 lg:col-start-6"
        >
            {
                concept.popup.objets.map((o) => (
                    <li>
                        <Media
                            src={o.image}
                            alt={o.name}
                            label={`Visuel : ${o.name.toLowerCase()}`}
                            ratio="aspect-[4/5]"
                        />
                        <h4 class="mt-3 font-display text-base font-semibold md:mt-4 md:text-lg">
                            {o.name}
                        </h4>
                        <p class="mt-1 text-sm leading-relaxed text-stone md:text-base">
                            {o.text}
                        </p>
                    </li>
                ))
            }
        </ul>
    </div>
</section>
