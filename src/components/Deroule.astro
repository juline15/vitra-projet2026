---
import { deroule } from "../data/event";
---

<section id="deroule" class="scroll-mt-24 border-t border-concrete">
    <div class="mx-auto max-w-screen-2xl px-5 py-16 md:px-10 md:py-24 lg:py-32">
        <h2
            class="font-display text-3xl font-semibold tracking-tight md:text-5xl lg:text-6xl"
        >
            Déroulé de la soirée
        </h2>

        {
            deroule.map((temps) => (
                <div class="mt-12 md:mt-20">
                    <div class="flex flex-wrap items-baseline justify-between gap-2 pb-3 md:pb-4">
                        <h3 class="font-display text-lg font-semibold md:text-xl">
                            {temps.title}
                        </h3>
                        <p class="text-sm text-stone">{temps.note}</p>
                    </div>
                    <ol>
                        {temps.steps.map((s) => (
                            <li class="grid gap-2 border-t border-ink py-5 md:grid-cols-12 md:gap-8 md:py-8">
                                <time
                                    datetime={s.time}
                                    class="font-display font-wide text-4xl leading-none font-light tabular-nums sm:text-5xl md:col-span-5 md:text-7xl lg:text-8xl"
                                >
                                    {s.time}
                                </time>
                                <div class="md:col-span-7 md:self-end lg:col-span-6 lg:col-start-7">
                                    <h4 class="font-display text-lg font-semibold md:text-xl lg:text-2xl">
                                        {s.title}
                                    </h4>
                                    <p class="mt-1 max-w-prose text-sm leading-relaxed text-stone md:mt-2 md:text-base">
                                        {s.text}
                                    </p>
                                </div>
                            </li>
                        ))}
                    </ol>
                </div>
            ))
        }
    </div>
</section>
