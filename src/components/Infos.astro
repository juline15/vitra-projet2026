---
import { event } from "../data/event";
const { location } = event;
---

<footer id="infos" class="scroll-mt-24 bg-ink text-paper">
    <div class="mx-auto max-w-screen-2xl px-5 py-16 md:px-10 md:py-24 lg:py-32">
        <h2
            class="font-display text-3xl font-semibold tracking-tight md:text-5xl lg:text-6xl"
        >
            Infos pratiques
        </h2>

        <dl
            class="mt-10 grid gap-8 border-t border-paper/30 pt-6 sm:grid-cols-2 md:mt-16 md:gap-10 md:pt-8 lg:grid-cols-4"
        >
            <div>
                <dt class="text-sm text-paper/60"><p>Date</p></dt>
                <dd class="mt-1 text-base md:mt-2 md:text-lg">
                    <p>{event.date}</p>
                </dd>
            </div>
            <div>
                <dt class="text-sm text-paper/60"><p>Adresse</p></dt>
                <dd class="mt-1 text-base md:mt-2 md:text-lg">
                    <address class="not-italic">
                        <p>
                            {location.name}<br />{location.address}<br />{
                                location.city
                            }<br />{location.country}
                        </p>
                    </address>
                </dd>
            </div>
            <div>
                <dt class="text-sm text-paper/60"><p>Accès</p></dt>
                <dd class="mt-1 text-base md:mt-2 md:text-lg">
                    <p>
                        Avant-première sur invitation.<br />Ouverture au public
                        différée.
                    </p>
                </dd>
            </div>
            <div>
                <dt class="text-sm text-paper/60"><p>Contact</p></dt>
                <dd class="mt-1 text-base md:mt-2 md:text-lg">
                    <p>{location.phone}</p>
                </dd>
            </div>
        </dl>

        <div
            class="mt-16 grid gap-2 border-t border-paper/30 pt-6 text-sm text-paper/60 md:mt-24 md:gap-4 lg:grid-cols-3"
        >
            <p>{event.title}</p>
            <p class="lg:text-center">
                Création{" "}
                <a
                    href="https://www.instagram.com/juline_crea/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-paper underline-offset-4 hover:underline"
                >
                    @juline_crea
                </a>
            </p>
            <p class="lg:text-right">Projet étudiant, non affilié à Vitra.</p>
        </div>
    </div>
</footer>
