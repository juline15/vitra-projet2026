---
import Media from "./Media.astro";
import { designer } from "../data/event";
---

<section id="designer" class="scroll-mt-24 bg-plaster">
    <div
        class="mx-auto grid max-w-screen-2xl gap-10 px-5 py-24 md:grid-cols-12 md:px-10 md:py-32"
    >
        <Media
            class="md:col-span-5"
            src={designer.portrait}
            alt={`Portrait de ${designer.name}`}
            label="Portrait du designer (3:4)"
            ratio="aspect-[3/4]"
        />

        <div class="flex flex-col md:col-span-6 md:col-start-7">
            <h2
                class="font-display text-4xl font-semibold tracking-tight md:text-6xl"
            >
                {designer.name}
            </h2>
            <p class="mt-3 text-stone">{designer.role}</p>

            <div class="mt-10 max-w-prose space-y-5 text-lg leading-relaxed">
                {designer.bio.map((p) => <p>{p}</p>)}
            </div>

            <div class="mt-auto pt-8 md:pt-12">
                <blockquote class="border-l-2 border-ink pl-6">
                    <p class="font-display text-xl leading-snug md:text-2xl">
                         {designer.quote}
                    </p>
                </blockquote>
            </div>
        </div>
    </div>
</section>
