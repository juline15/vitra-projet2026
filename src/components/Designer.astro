---
import Media from "./Media.astro";
import { designer } from "../data/event";
---

<section id="designer" class="scroll-mt-24 bg-plaster">
    <div
        class="mx-auto grid max-w-screen-2xl gap-8 px-5 py-16 md:grid-cols-12 md:gap-10 md:px-10 md:py-24 lg:py-32"
    >
        <Media
            class="w-full max-w-sm md:col-span-5 md:max-w-none"
            src={designer.portrait}
            alt={`Portrait de ${designer.name}`}
            label="Portrait du designer (3:4)"
            ratio="aspect-[3/4]"
        />

        <div class="flex flex-col md:col-span-7 lg:col-span-6 lg:col-start-7">
            <h2
                class="font-display text-3xl font-semibold tracking-tight md:text-5xl lg:text-6xl"
            >
                {designer.name}
            </h2>
            <p class="mt-2 text-stone md:mt-3">{designer.role}</p>

            <div
                class="mt-6 max-w-prose space-y-4 text-base leading-relaxed md:mt-10 md:space-y-5 md:text-lg"
            >
                {designer.bio.map((p) => <p>{p}</p>)}
            </div>

            <div class="mt-auto pt-8 md:pt-12">
                <blockquote class="border-l-2 border-ink pl-4 md:pl-6">
                    <p
                        class="font-display text-lg leading-snug md:text-xl lg:text-2xl"
                    >
                        {designer.quote}
                    </p>
                </blockquote>
            </div>
        </div>
    </div>
</section>
