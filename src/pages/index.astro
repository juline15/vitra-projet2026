---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Concept from "../components/Concept.astro";
import Designer from "../components/Designer.astro";
import Visuels from "../components/Visuels.astro";
import Deroule from "../components/Deroule.astro";
import Infos from "../components/Infos.astro";
import { event } from "../data/event";
---

<Layout
	title={`${event.title} | Vitra Design Museum`}
	description={event.subtitle}
>
	<Header />
	<main id="contenu">
		<Hero />
		<Concept />
		<Designer />
		<Visuels />
		<Deroule />
	</main>
	<Infos />
</Layout>
